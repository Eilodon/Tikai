ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tikai
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_JWT_SECRET=replace_me_with_at_least_32_chars
ANTHROPIC_API_KEY=replace_me
REDIS_URL=redis://localhost:6379
ALLOWED_ORIGINS=["http://localhost:3000"]
APP_BASE_URL=http://localhost:3000
SENTRY_DSN=
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=digest@tikai.vn
EMAIL_FROM_NAME=Tikai
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=admin@tikai.vn
ZALO_OA_ID=
ZALO_ZNS_ACCESS_TOKEN=
ADMIN_SECRET=

# Optional: override connection pool size when scaling replicas (default: 5 / 10)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# Staging: MUST set APP_BASE_URL to your staging URL (NOT app.tikai.vn)
# or the app will refuse to start (prevents staging emails linking to production)
# APP_BASE_URL=https://staging.tikai.vn
